# ============================================================
# Finmate - Variables de Entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Números separados por coma (formato WhatsApp)
WHATSAPP_RECIPIENTS=whatsapp:+56912345678,whatsapp:+56987654321

# --- APIs Financieras ---
FINNHUB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx
FMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx
ALPHA_VANTAGE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Calendar ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_ID=primary

# --- Scheduler ---
WEEKLY_SUMMARY_DAY=sun
WEEKLY_SUMMARY_HOUR=20
WEEKLY_SUMMARY_MINUTE=0
ALERT_CHECK_INTERVAL_MINUTES=30

# --- General ---
TIMEZONE=America/Santiago
PORT=5000
LOG_LEVEL=INFO

# --- Fase 0: agente con memoria persistente ---
# Base de datos Postgres gestionada (recomendado: Neon, https://neon.tech)
DATABASE_URL=postgresql://usuario:password@host.neon.tech/finmate?sslmode=require

# Cache Redis gestionado (recomendado: Upstash, https://upstash.com). Opcional:
# si se deja vacío, el agente funciona igual pero sin cache de cotizaciones.
REDIS_URL=

# API key de Anthropic (https://console.anthropic.com) para el orquestador del agente
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelos usados por el enrutado económico (decisión 01 del plan) — no hace
# falta tocarlos salvo que Anthropic publique versiones más nuevas.
ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-5
