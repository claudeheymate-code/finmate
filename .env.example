# ============================================================
# Finmate - Variables de Entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# --- Administradores por WhatsApp (avisos de seguridad y solicitudes) ---
# Números separados por coma (formato WhatsApp)
WHATSAPP_RECIPIENTS=whatsapp:+56912345678,whatsapp:+56987654321

# --- APIs Financieras ---
FINNHUB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx
ALPHA_VANTAGE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Fuentes en tiempo real (Etapa A, 16 nov 2026) — todas opcionales ---
# FRED (Fed de St. Louis): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# Banco Central de Chile (BDE → Mi Cuenta → Apikey Token)
BCCH_API_TOKEN=
# Marketaux: https://www.marketaux.com/dashboard (plan gratis 100 req/día)
MARKETAUX_API_KEY=
MARKETAUX_MIN_INTERVAL_MINUTES=20
NEWS_CHECK_INTERVAL_MINUTES=3
NEWS_ALERTS_MAX_PER_USER_PER_DAY=6

# --- Precios en tiempo real (Etapa B) — usa FINNHUB_API_KEY, nada nuevo que pagar ---
REALTIME_PRICES_ENABLED=true
REALTIME_EVAL_SECONDS=20
REALTIME_MAX_SYMBOLS=50

# --- Resumen de podcasts (Etapa C) ---
# Opcional: sin esta clave el resumen se hace con la descripción del episodio.
# Con ella se transcribe el audio (~USD 0,05 por episodio de 15 min).
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Google Calendar ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_ID=primary

# --- Scheduler ---
WEEKLY_SUMMARY_DAY=sun
WEEKLY_SUMMARY_HOUR=20
WEEKLY_SUMMARY_MINUTE=0
ALERT_CHECK_INTERVAL_MINUTES=30

# --- General ---
TIMEZONE=America/Santiago
PORT=5000
LOG_LEVEL=INFO

# --- Fase 0: agente con memoria persistente ---
# Base de datos Postgres gestionada (recomendado: Neon, https://neon.tech)
DATABASE_URL=postgresql://usuario:password@host.neon.tech/finmate?sslmode=require

# Cache Redis gestionado (recomendado: Upstash, https://upstash.com). Opcional:
# si se deja vacío, el agente funciona igual pero sin cache de cotizaciones.
REDIS_URL=

# API key de Anthropic (https://console.anthropic.com) para el orquestador del agente
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelos usados por el enrutado económico (decisión 01 del plan) — no hace
# falta tocarlos salvo que Anthropic publique versiones más nuevas.
ANTHROPIC_MODEL_DEFAULT=claude-haiku-5-5
ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-5-5

# --- Panel web (etapas 2 y 3) ---
# Clave larga y aleatoria para firmar la sesión del panel.
# Generala con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Acceso sin código, SOLO para desarrollo local. Nunca en producción.
PANEL_DEV_LOGIN=false

# --- WhatsApp por Meta (Cloud API) — único proveedor ---
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
# Plantillas aprobadas en WhatsApp Manager (por nombre):
# META_TEMPLATE_WATCHLIST_ALERT=finmate_watchlist_alert
# META_TEMPLATE_MARKET_NOTIFY=finmate_market_notify
# META_TEMPLATE_WEEKLY_SUMMARY_NOTIFY=finmate_weekly_summary_notify

# Noticias con texto completo (opcional): clave gratis en https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# Identificación que pide la SEC para leer EDGAR (opcional, tiene un valor por defecto)
SEC_USER_AGENT=

# --- Seguridad (opcionales) ---
# Aviso si el gasto de Claude del mes pasa este monto (USD). Default 15.
# SECURITY_CLAUDE_MONTHLY_ALERT_USD=15
